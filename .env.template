# ---------------------------------------------------------------------------
# Oracle 26ai Free, running in Docker on this machine.
# These values are set up automatically by START.bat.
# ---------------------------------------------------------------------------
ORACLE_USER=vector
ORACLE_PWD=vector
ORACLE_DSN=localhost:1521/FREEPDB1

# ---------------------------------------------------------------------------
# Google Gemini - FREE, no credit card.
#   1. Open https://aistudio.google.com/apikey
#   2. Create an API key and copy it
#   3. Paste it after the = below (no quotes, no spaces)
#
# Leave GEMINI_MODEL empty: the notebook picks a model that still has quota.
# Free tier is roughly 20 requests per day PER MODEL.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: only used if you leave GEMINI_API_KEY empty and want OpenAI instead.
OPENAI_API_KEY=
